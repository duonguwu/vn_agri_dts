        },
        "item_context": {
          "sector": "Cultivation",
          "commodity": "Lúa",
          "sub_item": "Đông Xuân",
          "variety": null,
          "processing_level": "Raw"
        },
        "metric_context": {
          "attribute": "Area_Planted",
          "value": 245962,
          "unit": "ha",
          "data_type": "Actual"
        },
        "comparison_context": {
          "comparison_type": "None",
          "comparison_value": null,
          "base_period": null,
          "base_value": null
        },
        "metadata": {
