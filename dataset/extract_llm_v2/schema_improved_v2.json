{
  "version": "2.0",
  "description": "Improved schema for Vietnamese Agricultural Data - Long Format",
  "structure": {
    "record_id": {
      "type": "string",
      "description": "Mã định danh duy nhất (UUID)",
      "constraint": "Unique",
      "required": true
    },
    "time_context": {
      "year": {
        "type": "integer",
        "constraint": "2008-2022",
        "required": true
      },
      "month": {
        "type": "integer",
        "constraint": "1-12",
        "required": true
      },
      "report_date": {
        "type": "string",
        "format": "YYYY-MM-DD",
        "description": "Ngày chốt số liệu trong báo cáo (ví dụ: 15/02/2009)",
        "required": false
      },
      "period_type": {
        "type": "string",
        "enum": [
          "Monthly",
          "Cumulative",
          "YTD",
          "Seasonal",
          "Annual",
          "Point_In_Time",
          "Event",
          "Yearly"
        ],
        "description": "Loại kỳ báo cáo: Tháng, Lũy kế, Đầu năm đến nay, Theo vụ",
        "required": false
      }
    },
    "geo_context": {
      "geo_level": {
        "type": "string",
        "enum": [
          "National",
          "Regional",
          "Provincial",
          "International",
          "Country"
        ],
        "required": true
      },
      "location_name": {
        "type": "string",
        "description": "Tên Tỉnh/Thành phố hoặc Vùng (ví dụ: An Giang, ĐBSCL)",
        "required": true
      },
      "region_id": {
        "type": "string",
        "description": "ID vùng (ví dụ: North_Central, Mekong_Delta)",
        "required": false
      },
      "region_name_vn": {
        "type": "string",
        "description": "Tên vùng tiếng Việt",
        "required": false
      }
    },
    "item_context": {
      "sector": {
        "type": "string",
        "enum": [
          "Cultivation",
          "Livestock",
          "Fishery",
          "Forestry",
          "Trade",
          "Investment",
          "Compliance",
          "Sugar_Production",
          "Industrial_Processing",
          "Industry",
          "Salt",
          "Metadata",
          "Pest"
        ],
        "required": true
      },
      "commodity": {
        "type": "string",
        "description": "Sản phẩm chính (ví dụ: Lúa, Lợn, Cá tra)",
        "required": false
      },
      "sub_item": {
        "type": "string",
        "description": "Chi tiết trà lúa/loại hình (ví dụ: Đông Xuân, Thẻ chân trắng)",
        "required": false
      },
      "variety": {
        "type": "string",
        "description": "Giống cụ thể (ví dụ: IR50404, ST25) - Nếu có",
        "required": false
      },
      "processing_level": {
        "type": "string",
        "enum": [
          "Raw",
          "Processed",
          "Semi_Processed"
        ],
        "description": "Mức độ chế biến",
        "required": false,
        "default": "Raw"
      }
    },
    "metric_context": {
      "attribute": {
        "type": "string",
        "enum": [
          "Area_Planted",
          "Area_Harvested",
          "Area_Seedling",
          "Production",
          "Yield",
          "Export_Value",
          "Export_Volume",
          "Import_Value",
          "Import_Volume",
          "Headcount",
          "Price",
          "Investment_Amount",
          "percent",
          "Forest_Area_Planted",
          "Forest_Area_Protected",
          "Wood_Volume",
          "Other",
          "Investment_Value",
          "Forest_Area_Cared",
          "Head_Count",
          "Area_Maintained",
          "Trees_Planted",
          "Area_Regenerated",
          "Area_Protected",
          "Area_Damaged",
          "Inventory",
          "Draft_Power",
          "Area_Tended",
          "Value",
          "Volume",
          "Output",
          "Area",
          "Has_Report",
          "Area_Infected",
          "Forest_Area",
          "Input_Volume",
          "Output_Volume",
          "Area_Flowering",
          "Area_Production",
          "Area_Cared",
          "Meat_Production",
          "HeadCount",
          "Area_Care"
        ],
        "description": "Tên chỉ tiêu",
        "required": true
      },
      "value": {
        "type": "float",
        "constraint": ">= 0",
        "required": true
      },
      "unit": {
        "type": "string",
        "enum": [
          "million_VND",
          "head",
          "1000_eggs",
          "1000_USD",
          "million_trees",
          "1000_m3",
          "1000_ton",
          "million_USD",
          "quintal_per_ha",
          "1000_ha",
          "1000_ton",
          "million_trees",
          "million_tree",
          "million_USD",
          "ton",
          "ha",
          "percent",
          "1000_m3",
          "Yield",
          "Has_Report",
          "percent",
          "Con",
          "ton_per_ha",
          "binary",
          "billion_VND"
        ],
        "description": "Đơn vị",
        "required": true
      },
      "data_type": {
        "type": "string",
        "enum": [
          "Actual",
          "Plan",
          "Cumulative",
          "Estimated",
          "Estimate"
        ],
        "description": "Số thực hiện, kế hoạch, lũy kế hay ước tính",
        "required": true
      }
    },
    "comparison_context": {
      "comparison_type": {
        "type": "string",
        "enum": [
          "None",
          "YoY",
          "MoM",
          "vs_Plan",
          "vs_Previous_Period"
        ],
        "description": "Loại so sánh",
        "required": false,
        "default": "None"
      },
      "comparison_value": {
        "type": "float",
        "description": "Giá trị so sánh (%, tỷ lệ)",
        "required": false
      },
      "base_period": {
        "type": "string",
        "description": "Kỳ gốc để so sánh",
        "required": false
      },
      "base_value": {
        "type": "float",
        "description": "Giá trị kỳ gốc",
        "required": false
      }
    },
    "metadata": {
      "source_file": {
        "type": "string",
        "required": true
      },
      "appendix_number": {
        "type": "string",
        "description": "Số phụ lục (PL1, PL2, ...)",
        "required": true
      }
    }
  },
  "validation_rules": {
    "unique_keys": [
      "year",
      "month",
      "location_name",
      "sector",
      "commodity",
      "attribute",
      "data_type"
    ],
    "required_combinations": {
      "cultivation": [
        "commodity",
        "attribute"
      ],
      "trade": [
        "commodity",
        "attribute"
      ],
      "investment": [
        "attribute"
      ]
    }
  },
  "notes": [
    "Schema này được thiết kế cho long-format data, mỗi record là một observation",
    "Tất cả các field trong time_context, geo_context, item_context, metric_context đều bắt buộc",
    "comparison_context và data_quality là optional nhưng nên có để tracking quality",
    "Đơn vị cần được normalize về cùng một hệ thống (1000_ha, 1000_ton, ...)"
  ]
}